{
  "defaultAction": "SCMP_ACT_ALLOW",
  "archMap": [
    { "architecture": "SCMP_ARCH_AARCH64", "subArchitectures": ["SCMP_ARCH_ARM"] }
  ],
  "syscalls": [
    {
      "names": ["seccomp", "ptrace", "personality", "reboot", "mount", "umount2", "swapon", "swapoff", "syslog", "kexec_load", "init_module", "finit_module", "delete_module", "acct", "chroot", "pivot_root", "setns"],
      "action": "SCMP_ACT_KILL"
    },
    {
      "names": ["socket", "connect", "bind", "listen", "accept", "accept4", "sendto", "recvfrom", "sendmsg", "recvmsg", "socketpair", "setsockopt", "getsockopt", "getpeername", "getsockname", "shutdown"],
      "action": "SCMP_ACT_ERRNO"
    }
  ]
}
